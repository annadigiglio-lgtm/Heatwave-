# Copia questo file in .env e inserisci i valori reali.
# .env non va mai committato (è escluso da .gitignore).

# Database PostgreSQL/PostGIS (serve solo per ETL, analisi e training K-Means;
# la dashboard e il chatbot leggono lo snapshot in data/dashboard_export/)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=heatwave_piemonte
DB_USER=postgres
DB_PASSWORD=inserisci_la_password

# Copernicus Climate Data Store (facoltativo)
CDS_URL=https://cds.climate.copernicus.eu/api
CDS_KEY=inserisci_la_chiave

# OpenStreetMap / Nominatim
OSM_USER_AGENT=heatwave-piemonte

# Logging
LOG_LEVEL=INFO

# Streamlit
STREAMLIT_SERVER_PORT=8501

# Chatbot — Ollama in locale (predefinito)
OLLAMA_HOST=http://localhost:11434

# Chatbot — provider Anthropic (facoltativo, solo con chatbot.provider: anthropic)
ANTHROPIC_API_KEY=

# Chatbot — provider Gemini (piano gratuito: chiave da https://aistudio.google.com)
GOOGLE_API_KEY=
